{
  "name": "webweaver-mcp-server",
  "version": "2.0.0",
  "type": "module",
  "description": "MCP server for WebWeaver Nexus — contact form, product overview, and contact info",
  "main": "dist/main.js",
  "scripts": {
    "build": "cross-env INPUT=mcp-app.html vite build && tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.server.json && tsc -p tsconfig.server.json",
    "check:contract": "tsx scripts/contract.ts check",
    "sync:contract": "tsx scripts/contract.ts sync",
    "watch": "cross-env INPUT=mcp-app.html vite build --watch",
    "serve": "tsx main.ts",
    "serve:stdio": "tsx main.ts --stdio",
    "dev": "cross-env NODE_ENV=development concurrently \"npm run watch\" \"npm run serve\"",
    "start": "cross-env NODE_ENV=development npm run build && npm run serve"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
