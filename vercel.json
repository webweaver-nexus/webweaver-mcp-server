{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".",
  "functions": {
    "dist/main.js": {
      "runtime": "@vercel/node@latest",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/dist/main.js" },
    { "source": "/mcp/:path*", "destination": "/dist/main.js" }
  ],
  "headers": [
    {
      "source": "/mcp",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
